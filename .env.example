DATABASE_URL="postgresql://dev:dev@localhost:5432/canvase_ui?schema=public"
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3917"
NEXT_PUBLIC_APP_URL="http://localhost:3917"

# Open-source generation proxy (OpenAI-compatible gateway).
# UI configures Base URL + model list only — never browser API keys.
# GENERATION_BASE_URL="https://api.openai.com"
# Optional server-side bearer injected by /v1 proxy (leave unset for local Ollama etc.)
# GENERATION_API_KEY="sk-..."
# SSRF guard: by default the /v1 proxy and agent chat attachments may only reach
# public hosts. Allow local gateways (Ollama, LM Studio, MinIO) or pin hosts:
# GENERATION_ALLOW_PRIVATE_HOSTS="true"
# GENERATION_ALLOWED_HOSTS="api.openai.com,gateway.example.com"

# Object storage (S3 / R2 / MinIO compatible). User settings in Canvas → Storage
# override these. Used for media library uploads via browser presigned PUT.
# API endpoint host only — do NOT append /bucket (path-style PUT uses /{bucket}/{key}).
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="canvase-media"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_PUBLIC_BASE_URL="https://cdn.example.com"
# S3_FORCE_PATH_STYLE="true"
# Optional: encrypt user-stored secrets (S3 + generation API keys; defaults to BETTER_AUTH_SECRET)
# STORAGE_SECRET="replace-with-openssl-rand-base64-32"

# BullMQ / asset thumbnail worker (local Redis; do not bind compose Redis on 6379)
# REDIS_URL="redis://127.0.0.1:6379/1"  # use /1 locally if tu_api uses /0
# Optional ffmpeg binary for video posters (defaults to PATH "ffmpeg")
# FFMPEG_PATH="/usr/local/bin/ffmpeg"

# Agent skills: folder of skill packs (<skill-id>/SKILL.md). Defaults to ./skills.
# Read by the built-in canvas agent and the MCP tool gateway.
# CANVASE_SKILLS_DIR="/absolute/path/to/skills"
