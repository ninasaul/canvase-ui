generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CanvasStatus {
  active
  archived
}

model User {
  id             String              @id @default(cuid())
  name           String
  email          String
  emailVerified  Boolean             @default(false)
  image          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sessions       Session[]
  accounts       Account[]
  canvases       Canvas[]
  mediaAssets       MediaAsset[]
  storageConfig     UserStorageConfig?
  generationConfig  UserGenerationConfig?
  agentTokens       AgentToken[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Canvas {
  id               String             @id @default(cuid())
  ownerId          String
  owner            User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title            String
  graph            Json
  version          Int                @default(1)
  status           CanvasStatus       @default(active)
  thumbnailAssetId String?
  thumbnailAsset   MediaAsset?        @relation(fields: [thumbnailAssetId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  agentTokens      AgentToken[]
  commandLogs      CanvasCommandLog[]
  agentRuns        CanvasAgentRun[]
  chatMessages     CanvasChatMessage[]
  chatSummaries    CanvasChatSummary[]

  @@index([ownerId, updatedAt])
  @@index([thumbnailAssetId])
  @@map("canvas")
}

/// Agent chat transcript. Append-only: tabs never overwrite each other.
/// Rolling summary of a long conversation: older turns are folded into
/// `summary` so the model keeps continuity without re-reading everything.
model CanvasChatSummary {
  id           String   @id @default(cuid())
  canvasId     String
  canvas       Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  sessionId    String
  summary      String
  /// Everything at or before this timestamp is folded into the summary. A
  /// watermark survives pruning, clearing and partial loads, unlike a count.
  coveredThrough DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([canvasId, sessionId])
  @@map("canvas_chat_summary")
}

model CanvasChatMessage {
  id          String   @id @default(cuid())
  canvasId    String
  canvas      Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  ownerId     String
  /// "user" | "assistant"
  role        String
  content     String
  /// Conversation boundary. A new session starts fresh model context while the
  /// transcript keeps every earlier session for scrolling back.
  sessionId   String
  /// [{ url, kind, name? }] for user turns.
  attachments Json?
  /// Client message id; dedupes retries of the same user turn.
  clientId    String?
  createdAt   DateTime @default(now())

  @@unique([canvasId, clientId])
  @@index([canvasId, createdAt])
  @@index([canvasId, sessionId, createdAt])
  @@map("canvas_chat_message")
}

enum AgentTokenActorType {
  user
  agent
}

/// Short-lived scoped token for external agents (Codex MCP / HTTP tools).
model AgentToken {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  canvasId   String
  canvas     Canvas    @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  tokenHash  String
  label      String    @default("")
  scopes     String[]
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tokenHash])
  @@index([ownerId, canvasId])
  @@index([canvasId, revokedAt])
  @@map("agent_token")
}

model CanvasCommandLog {
  id            String              @id @default(cuid())
  canvasId      String
  canvas        Canvas              @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  actorType     AgentTokenActorType
  actorId       String
  tool          String
  input         Json
  result        Json
  versionBefore Int
  versionAfter  Int
  createdAt     DateTime            @default(now())

  @@index([canvasId, createdAt])
  @@map("canvas_command_log")
}

enum CanvasAgentRunStatus {
  queued
  running
  succeeded
  partial
  failed
  cancelled
}

/// Server-side generation run triggered by Agent tools (Codex MCP).
model CanvasAgentRun {
  id          String               @id @default(cuid())
  canvasId    String
  canvas      Canvas               @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  ownerId     String
  mode        String
  status      CanvasAgentRunStatus @default(queued)
  nodeIds     String[]
  /// Record<nodeId, { status, error?, requestId?, outputUrl? }>
  nodeStates  Json                 @default("{}")
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([canvasId, createdAt])
  @@index([ownerId, status, createdAt])
  @@map("canvas_agent_run")
}

enum MediaType {
  image
  video
  audio
  other
}

enum MediaAssetStatus {
  pending
  ready
  failed
}

model MediaAsset {
  id                  String           @id @default(cuid())
  ownerId             String
  owner               User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  objectKey           String
  url                 String
  mimeType            String
  mediaType           MediaType
  purpose             String           @default("playground_upload")
  displayName         String
  sizeBytes           Int
  thumbnailUrl        String?
  thumbnailObjectKey  String?
  thumbnailWidth      Int?
  thumbnailHeight     Int?
  status              MediaAssetStatus @default(pending)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  canvasCovers        Canvas[]

  @@index([ownerId, createdAt])
  @@index([ownerId, status, createdAt])
  @@map("media_asset")
}

model UserStorageConfig {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint             String
  region               String   @default("auto")
  bucket               String
  accessKeyId          String
  secretAccessKeyCipher String
  secretAccessKeyIv    String
  publicBaseUrl        String
  forcePathStyle       Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_storage_config")
}

/// Per-user generation gateways. API keys are AES-GCM encrypted at rest.
model UserGenerationConfig {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeVendorId String
  /// Record<vendorId, { baseUrl, apiKeyCipher?, apiKeyIv? }>
  profilesJson   Json
  /// ByokModelPreset[]
  modelsJson     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("user_generation_config")
}
